    <script>
document.addEventListener('DOMContentLoaded', async function() {
    // check if user is logged in
    const token = localStorage.getItem('token');
    if (!token) {
        window.location.href = 'login.html';
        return;
    }

    // fetch user profile
    const response = await fetch('http://localhost:5113/api/Dashboard/profile', {
        headers: { 'Authorization': 'Bearer ' + token }
    });

    // deposit
document.getElementById('depositBtn').addEventListener('click', async function() {
    const amount = parseFloat(document.getElementById('depositAmount').value);
    const response = await fetch('http://localhost:5113/api/Dashboard/deposit', {
        method: 'POST',
        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
        body: JSON.stringify({ amount })
    });
    if (response.ok) {
        const data = await response.json();
        document.getElementById('userBalance').textContent = 'KES ' + data.balance.toFixed(2);
        alert('Deposit successful!');
    } else { alert('Deposit failed'); }
});

// withdraw
document.getElementById('withdrawBtn').addEventListener('click', async function() {
    const amount = parseFloat(document.getElementById('withdrawAmount').value);
    const response = await fetch('http://localhost:5113/api/Dashboard/withdraw', {
        method: 'POST',
        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
        body: JSON.stringify({ amount })
    });
    if (response.ok) {
        const data = await response.json();
        document.getElementById('userBalance').textContent = 'KES ' + data.balance.toFixed(2);
        alert('Withdrawal successful!');
    } else { alert('Insufficient funds or error'); }
});

    if (response.ok) {
        const user = await response.json();
        // update user name in navbar
        document.getElementById('userFullName').textContent = user.fullName;
        // update balance card
        document.getElementById('userBalance').textContent = 'KES ' + user.balance.toFixed(2);
    } else {
        // token expired, redirect to login
        localStorage.removeItem('token');
        window.location.href = 'login.html';
    }

    // fetch transactions
    const txResponse = await fetch('http://localhost:5113/api/Dashboard/transactions', {
        headers: { 'Authorization': 'Bearer ' + token }
    });

    if (txResponse.ok) {
        const transactions = await txResponse.json();
        const tbody = document.getElementById('transactionTable');
        transactions.slice(0, 5).forEach(tx => {
            tbody.innerHTML += `
                <tr>
                    <td>${tx.type}</td>
                    <td>KES ${tx.amount.toFixed(2)}</td>
                    <td>KES ${tx.balanceAfter.toFixed(2)}</td>
                    <td>${new Date(tx.createdAt).toLocaleDateString()}</td>
                </tr>`;
        });
    }
});
</script>

</body>

</html>